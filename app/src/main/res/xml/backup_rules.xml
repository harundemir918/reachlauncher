<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 9–11 backup rules (Android 12+ uses data_extraction_rules.xml). Backup is
    already off via allowBackup="false"; this file excludes everything as well, so the
    intent stays explicit if that flag ever changes.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
