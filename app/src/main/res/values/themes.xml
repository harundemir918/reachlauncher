<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Window theme only. Everything visible is drawn by Compose (ReachTheme); this
        just makes the window background match the default palette so there is no
        white flash before the first frame. values-night/ holds the dark variant.
        System bar colours are set at runtime by enableEdgeToEdge().
    -->
    <style name="Theme.Reach" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/reach_window_bg</item>
    </style>

    <color name="reach_window_bg">#F4F2EC</color>
</resources>
