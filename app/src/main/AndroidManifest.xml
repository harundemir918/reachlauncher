<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Package visibility (Android 11+): a launcher only needs to see apps that have a
        launcher activity, so we declare exactly that query instead of the broad
        QUERY_ALL_PACKAGES permission (restricted by Google Play). See docs/DECISIONS.md.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <!--
        No backups: launch history and settings never leave the device, not even through
        Google's cloud backup (docs/DECISIONS.md D9; PRIVACY.md from M3). allowBackup covers Android 9–11;
        dataExtractionRules covers Android 12+, where allowBackup alone is ignored for
        device-to-device transfers.
    -->
    <application
        android:name=".ReachApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Reach">

        <!--
            The home screen.
            - MAIN + HOME + DEFAULT makes Reach selectable as the default home app.
            - singleTask: there is only ever one Home; pressing Home delivers onNewIntent
              to the existing instance instead of creating a new one.
            - excludeFromRecents: Home shouldn't appear as a card in the Recents screen.
            - stateNotNeeded: the system may restart Home without saved state (we keep
              no state that matters across process death).
            - clearTaskOnLaunch: relaunching Home always shows Home itself, never a
              leftover activity in its task.
            - resumeWhilePausing: Home resumes while the closing app is still pausing,
              so it appears immediately when the user presses Home.
            - adjustResize + edge-to-edge: we handle IME insets ourselves in Compose.
            - configChanges: Home must never be torn down and rebuilt (that would flash
              an empty screen). Compose already reacts to configuration changes (dark
              mode, font scale, locale, rotation) by recomposing.
            The extra LAUNCHER filter lets you open Reach from another launcher (and
            lets Android Studio "Run" it) before it is the default home.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true"
            android:resumeWhilePausing="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|fontWeightAdjustment|colorMode|locale|layoutDirection"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
