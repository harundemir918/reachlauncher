# Release signing for ./gradlew assembleRelease / bundleRelease (docs/DECISIONS.md D69).
# Copy to `keystore.properties` (git-ignored) and fill in. Paths are relative to the repo root.
# On CI, set REACH_KEYSTORE_FILE, REACH_KEYSTORE_PASSWORD, REACH_KEY_ALIAS and
# REACH_KEY_PASSWORD instead. Without either, release builds are signed with the debug key
# (installable for testing, rejected by Google Play).
storeFile=release/reach-upload.jks
storePassword=change-me
keyAlias=reach
keyPassword=change-me
