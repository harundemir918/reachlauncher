root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
ktlint_code_style = ktlint_official
max_line_length = 140
# Composable functions are PascalCase by convention (they behave like widgets/classes).
ktlint_function_naming_ignore_when_annotated_with = Composable
# Allow `object ReachTheme` next to `fun ReachTheme()` and similar Compose idioms.
ktlint_standard_filename = disabled

[*.{xml,toml,md}]
indent_size = 4
